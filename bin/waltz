#!/usr/bin/env bash
set -euo pipefail
# readlink -f, not just dirname "${BASH_SOURCE[0]}": install.sh symlinks this
# script into ~/.local/bin, and BASH_SOURCE doesn't resolve symlinks on its
# own — without this, running via that symlink resolves DIR to ~/.local
# instead of the actual install directory and fails with "No module named waltz".
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
cd "$DIR"
exec python3 -m waltz "$@"
